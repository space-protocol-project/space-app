# Файловый посредник собирается из исходников вместе с приложением.
find_program(SPACE_GO_EXECUTABLE go REQUIRED)
get_filename_component(SPACE_CATALOG_SOURCE "${CMAKE_CURRENT_LIST_DIR}/../native/space_catalog" ABSOLUTE)
if(WIN32)
  set(SPACE_CATALOG_NAME "space-catalog.exe")
else()
  set(SPACE_CATALOG_NAME "space-catalog")
endif()
set(SPACE_CATALOG_OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/${SPACE_CATALOG_NAME}")
if(CMAKE_GENERATOR_PLATFORM MATCHES "ARM64" OR CMAKE_SYSTEM_PROCESSOR MATCHES "^(aarch64|arm64)$")
  set(SPACE_CATALOG_ARCH arm64)
elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "^(AMD64|amd64|x86_64)$" OR CMAKE_GENERATOR_PLATFORM STREQUAL "x64")
  set(SPACE_CATALOG_ARCH amd64)
else()
  message(FATAL_ERROR "Unsupported catalog architecture")
endif()
file(GLOB SPACE_CATALOG_INPUTS CONFIGURE_DEPENDS "${SPACE_CATALOG_SOURCE}/*.go" "${SPACE_CATALOG_SOURCE}/go.mod")
add_custom_command(OUTPUT "${SPACE_CATALOG_OUTPUT}" "${SPACE_CATALOG_OUTPUT}.sha256"
  COMMAND "${CMAKE_COMMAND}" -E env CGO_ENABLED=0 "GOARCH=${SPACE_CATALOG_ARCH}" "${SPACE_GO_EXECUTABLE}" build -trimpath -o "${SPACE_CATALOG_OUTPUT}" .
  COMMAND "${CMAKE_COMMAND}" "-DBINARY=${SPACE_CATALOG_OUTPUT}" -P "${CMAKE_CURRENT_LIST_DIR}/catalog_hash.cmake"
  WORKING_DIRECTORY "${SPACE_CATALOG_SOURCE}"
  DEPENDS ${SPACE_CATALOG_INPUTS} "${CMAKE_CURRENT_LIST_DIR}/catalog_hash.cmake"
  VERBATIM)
add_custom_target(space_catalog ALL DEPENDS "${SPACE_CATALOG_OUTPUT}" "${SPACE_CATALOG_OUTPUT}.sha256")
add_dependencies(${BINARY_NAME} space_catalog)
install(PROGRAMS "${SPACE_CATALOG_OUTPUT}" DESTINATION "${CMAKE_INSTALL_PREFIX}" COMPONENT Runtime)
install(FILES "${SPACE_CATALOG_OUTPUT}.sha256" DESTINATION "${CMAKE_INSTALL_PREFIX}" COMPONENT Runtime)

get_filename_component(SPACE_WASM_SOURCE "${CMAKE_CURRENT_LIST_DIR}/../native/space_client_wasm" ABSOLUTE)
set(SPACE_WASM_NAME "space-client-wasm")
if(WIN32)
  set(SPACE_WASM_NAME "space-client-wasm.exe")
endif()
set(SPACE_WASM_OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/${SPACE_WASM_NAME}")
file(GLOB SPACE_WASM_INPUTS CONFIGURE_DEPENDS "${SPACE_WASM_SOURCE}/*.go" "${SPACE_WASM_SOURCE}/go.mod" "${SPACE_WASM_SOURCE}/go.sum")
add_custom_command(OUTPUT "${SPACE_WASM_OUTPUT}" "${SPACE_WASM_OUTPUT}.sha256"
  COMMAND "${CMAKE_COMMAND}" -E env CGO_ENABLED=0 "GOARCH=${SPACE_CATALOG_ARCH}" "${SPACE_GO_EXECUTABLE}" build -trimpath -o "${SPACE_WASM_OUTPUT}" .
  COMMAND "${CMAKE_COMMAND}" "-DBINARY=${SPACE_WASM_OUTPUT}" -P "${CMAKE_CURRENT_LIST_DIR}/catalog_hash.cmake"
  WORKING_DIRECTORY "${SPACE_WASM_SOURCE}"
  DEPENDS ${SPACE_WASM_INPUTS} "${CMAKE_CURRENT_LIST_DIR}/catalog_hash.cmake"
  VERBATIM)
add_custom_target(space_client_wasm ALL DEPENDS "${SPACE_WASM_OUTPUT}" "${SPACE_WASM_OUTPUT}.sha256")
add_dependencies(${BINARY_NAME} space_client_wasm)
install(PROGRAMS "${SPACE_WASM_OUTPUT}" DESTINATION "${CMAKE_INSTALL_PREFIX}" COMPONENT Runtime)
install(FILES "${SPACE_WASM_OUTPUT}.sha256" DESTINATION "${CMAKE_INSTALL_PREFIX}" COMPONENT Runtime)

if(UNIX AND NOT APPLE)
  install(DIRECTORY "${CMAKE_CURRENT_LIST_DIR}/../packaging/linux-wasm/"
    DESTINATION "${CMAKE_INSTALL_PREFIX}/linux-wasm" COMPONENT Runtime)
endif()
